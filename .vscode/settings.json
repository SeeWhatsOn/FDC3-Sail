{
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,
  "eslint.validate": ["javascript", "javascriptreact", "typescript", "typescriptreact"],
  "eslint.workingDirectories": [
    {
      "mode": "auto"
    }
  ],
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "never",
    "source.fixAll.oxc": "explicit"
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/.git/**": true
  },
  "cucumber.glue": ["packages/sail-desktop-agent/test/step-definitions/**/*.ts"],
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "[javascript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "oxc.fmt.configPath": "./.oxfmtrc.json",
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "file",
  "workbench.colorCustomizations": {
    "activityBar.activeBackground": "#8686d4",
    "activityBar.background": "#8686d4",
    "activityBar.foreground": "#15202b",
    "activityBar.inactiveForeground": "#15202b99",
    "activityBarBadge.background": "#eed0d0",
    "activityBarBadge.foreground": "#15202b",
    "commandCenter.border": "#e7e7e799",
    "sash.hoverBorder": "#8686d4",
    "statusBar.background": "#6161c6",
    "statusBar.foreground": "#e7e7e7",
    "statusBarItem.hoverBackground": "#8686d4",
    "statusBarItem.remoteBackground": "#5e2222",
    "statusBarItem.remoteForeground": "#e7e7e7",
    "titleBar.activeBackground": "#6161c6",
    "titleBar.activeForeground": "#595959",
    "titleBar.inactiveBackground": "#6161c699",
    "titleBar.inactiveForeground": "#e7e7e799",
    "activityBarTop.activeBackground": "#8686d4",
    "activityBarTop.background": "#8686d4",
    "activityBarTop.foreground": "#15202b",
    "activityBarTop.inactiveForeground": "#15202b99",
    "commandCenter.foreground": "#595959",
    "statusBar.debuggingBackground": "#6161c6",
    "statusBar.debuggingForeground": "#e7e7e7"
  },
  "peacock.color": "#6161c6"
}
